<link name="CAM_FRONT_RIGHT/camera_link"><visual><origin rpy="0 0 0.9599310886"/><geometry><mesh filename="package://four_ws_vehicle_description/mesh/sensor_CAM_FRONT_RIGHT.dae"/></geometry></visual></link>
<joint name="CAM_FRONT_RIGHT_mount_joint" type="fixed"><parent link="sensor_kit_base_link"/><child link="CAM_FRONT_RIGHT/camera_link"/><origin xyz="1.5932500000 0.3100000000 1.7550000000" rpy="0.0000000000 0.0000000000 -0.9599310886"/></joint>
<link name="CAM_FRONT_RIGHT/camera_optical_link"/>
<joint name="CAM_FRONT_RIGHT_optical_joint" type="fixed"><parent link="CAM_FRONT_RIGHT/camera_link"/><child link="CAM_FRONT_RIGHT/camera_optical_link"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>
<link name="CAM_BACK/camera_link"><visual><origin rpy="0 0 -3.1415926536"/><geometry><mesh filename="package://four_ws_vehicle_description/mesh/sensor_CAM_BACK.dae"/></geometry></visual></link>
<joint name="CAM_BACK_mount_joint" type="fixed"><parent link="sensor_kit_base_link"/><child link="CAM_BACK/camera_link"/><origin xyz="-0.3767500000 0.4300000000 1.7550000000" rpy="0.0000000000 0.0000000000 3.1415926536"/></joint>
