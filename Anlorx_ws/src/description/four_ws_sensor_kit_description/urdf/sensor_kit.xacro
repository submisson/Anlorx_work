<?xml version="1.0"?><robot xmlns:xacro="http://ros.org/wiki/xacro"><xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
<link name="sensor_kit_base_link"/>
<joint name="sensor_kit_base_joint" type="fixed"><parent link="${parent}"/><child link="sensor_kit_base_link"/><origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/></joint>
<link name="velodyne_top_base_link"><visual><origin rpy="0 0 0.0000000000"/><geometry><mesh filename="package://four_ws_vehicle_description/mesh/sensor_lidar_top.dae"/></geometry></visual></link>
<joint name="lidar_top_mount_joint" type="fixed"><parent link="sensor_kit_base_link"/><child link="velodyne_top_base_link"/><origin xyz="0.6082500000 0.4400000000 1.8650000000" rpy="0.0000000000 0.0000000000 0.0000000000"/></joint>
<link name="velodyne_top"/>
<joint name="velodyne_top_joint" type="fixed"><parent link="velodyne_top_base_link"/><child link="velodyne_top"/></joint>
<link name="CAM_FRONT/camera_link"><visual><origin rpy="0 0 0.0000000000"/><geometry><mesh filename="package://four_ws_vehicle_description/mesh/sensor_CAM_FRONT.dae"/></geometry></visual></link>
<joint name="CAM_FRONT_mount_joint" type="fixed"><parent link="sensor_kit_base_link"/><child link="CAM_FRONT/camera_link"/><origin xyz="1.5932500000 0.4300000000 1.7550000000" rpy="0.0000000000 0.0000000000 0.0000000000"/></joint>
<link name="CAM_FRONT/camera_optical_link"/>
<joint name="CAM_FRONT_optical_joint" type="fixed"><parent link="CAM_FRONT/camera_link"/><child link="CAM_FRONT/camera_optical_link"/><origin rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>
<link name="CAM_FRONT_LEFT/camera_link"><visual><origin rpy="0 0 -0.9599310886"/><geometry><mesh filename="package://four_ws_vehicle_description/mesh/sensor_CAM_FRONT_LEFT.dae"/></geometry></visual></link>
