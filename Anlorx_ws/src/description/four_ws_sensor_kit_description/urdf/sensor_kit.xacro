<link name="CAM_BACK_LEFT/camera_link"><visual><origin rpy="0 0 -2.1816615650"/><geometry><mesh filename="package://four_ws_vehicle_description/mesh/sensor_CAM_BACK_LEFT.dae"/></geometry></visual></link>
<joint name="CAM_BACK_LEFT_mount_joint" type="fixed"><parent link="sensor_kit_base_link"/><child link="CAM_BACK_LEFT/camera_link"/><origin xyz="-0.2217500000 0.5650000000 1.7550000000" rpy="0.0000000000 0.0000000000 2.1816615650"/></joint>
<link name="CAM_BACK_LEFT/camera_optical_link"/>
